# Required environment variables for Claude Code tools
# =====================================================
# Copy this as guidance and set real values in ~/.claude-secrets.fish
# (that file is loaded by fish on startup and NOT tracked in git)
#
# Usage:
#   cp configs/claude/env.example ~/.claude-secrets.fish
#   # then edit ~/.claude-secrets.fish with your real tokens

# Context7 API Key
# Get at: https://context7.com/api-access (or check your account settings)
set -gx CONTEXT7_API_KEY "your_context7_key_here"
