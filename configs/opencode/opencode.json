{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "fff": {
      "type": "local",
      "command": [
        "/Users/ehrax/.local/bin/fff-mcp",
        "--no-warmup",
        "--max-cached-files",
        "5000"
      ],
      "enabled": true
    }
  }
}
