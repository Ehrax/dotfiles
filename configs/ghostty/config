# Ghostty Terminal Configuration
# https://ghostty.org/docs/config

# Font
font-family = "FiraCode Nerd Font"
font-size = 14

# Shell
command = /opt/homebrew/bin/fish

# Window
window-padding-x = 10
window-padding-y = 10
window-decoration = true
macos-titlebar-style = tabs

# Cursor (block/square, no blinking)
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Mouse
mouse-hide-while-typing = true

# Clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = true

# Scrollback
scrollback-limit = 10000

# =============================================================================
# One Dark Color Scheme
# =============================================================================

background = 282c34
foreground = abb2bf

# Normal colors
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf

# Bright colors
palette = 8=#545862
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#e5c07b
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#c8ccd4

# Selection
selection-background = 3e4451
selection-foreground = abb2bf
